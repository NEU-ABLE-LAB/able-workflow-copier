import shutil
import textwrap
from pathlib import Path

import pytest
from loguru import logger

from . import _snakemake


# --- Helpers ----------------------------------------------------------------
def _build_workspace(
    tmp_path_factory: pytest.TempPathFactory,
    request: pytest.FixtureRequest,
    *,
    copy_config: bool,
) -> Path:
    snakefile_loc = request.param
    test_module = request.module.__name__
    config_mode = "with_config" if copy_config else "empty_config"
    basename = f"{test_module}_{snakefile_loc}_{config_mode}"

    tmp_path = tmp_path_factory.mktemp(
        basename=basename,
        numbered=True,
    )
    logger.debug(f"Working in a temporary project root: {tmp_path}")

    repo_root = request.config.rootdir

    if copy_config:
        shutil.copytree(repo_root / "config", tmp_path / "config")

    if snakefile_loc == "proj_root":
        snakefile_dir = tmp_path
        shutil.copytree(
            repo_root / "workflow" / "profiles",
            tmp_path / "profiles"
        )
    elif snakefile_loc == "workflow":
        snakefile_dir = tmp_path / "workflow"
        snakefile_dir.mkdir()
        shutil.copytree(
            repo_root / "workflow" / "profiles",
            tmp_path / "workflow" / "profiles"
        )
    else:
        raise ValueError(f"Unknown location: {snakefile_loc}")

    (snakefile_dir / "Snakefile").write_text(
        textwrap.dedent(
            f"""\
        module {{ package_name }}:
            snakefile: "{repo_root / 'workflow' / 'Snakefile'}"
            config: config

        use rule * from {{ package_name }}
        """
        )
    )

    verbose = request.config.getoption("verbose")
    _snakemake(tmp_path, ["conda_localize"], verbose=verbose)

    return tmp_path


# --- Fixtures ---------------------------------------------------------------
@pytest.fixture(
    params=[
        # "proj_root",
        "workflow",
    ]
)
def workspace(
    tmp_path_factory: pytest.TempPathFactory,
    request: pytest.FixtureRequest,
) -> Path:
    """One disposable Snakemake working directory with committed config."""
    return _build_workspace(tmp_path_factory, request, copy_config=True)


@pytest.fixture(
    params=[
        # "proj_root",
        "workflow",
    ]
)
def workspace_empty_config(
    tmp_path_factory: pytest.TempPathFactory,
    request: pytest.FixtureRequest,
) -> Path:
    """One disposable Snakemake working directory without committed config."""
    return _build_workspace(tmp_path_factory, request, copy_config=False)
